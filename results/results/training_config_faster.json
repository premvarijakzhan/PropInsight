{
  "preset": "faster",
  "model_id": "aisingapore/Qwen-SEA-LION-v4-32B-IT",
  "bnb_4bit": {
    "quant_type": "nf4",
    "compute_dtype": "bfloat16",
    "double_quant": true
  },
  "lora": {
    "r": 8,
    "alpha": 16,
    "dropout": 0.05,
    "targets": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "max_steps": 600,
  "seq_len": 1024,
  "grad_accum": 16,
  "lr": 0.0002,
  "eval_strategy": "epoch",
  "save_strategy": "epoch"
}